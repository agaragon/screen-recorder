<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to write the recorded video to external storage (API < 29) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Required to post the mandatory foreground-service notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required for the foreground service that holds the MediaProjection token -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenRecorder">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            foregroundServiceType="mediaProjection" is mandatory on API 29+.
            Without it the system revokes the MediaProjection token when the
            activity goes to the background.
        -->
        <service
            android:name=".ScreenRecorderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
